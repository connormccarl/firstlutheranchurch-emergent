// schema.prisma — single source of truth for the @connormccarl/nextos data model.
//
// Auth.js v5 (NextAuth.js) + Prisma adapter compatible schema. The four
// standard Auth.js models (User, Account, Session, VerificationToken) coexist
// with our custom tables for brute-force lockout and password reset.
//
//   Auth.js standard models:
//     - User                 identity (Auth.js requires: email, emailVerified, image)
//     - Account              OAuth account linking (unused in Credentials-only setup,
//                            but populated automatically if we add Google/etc. later)
//     - Session              database sessions (unused in Credentials + JWT mode,
//                            but populated by Auth.js once an OAuth provider is added)
//     - VerificationToken    email verification / magic-link tokens (currently unused)
//
//   Custom NextOS models (Credentials-flow only):
//     - PasswordReset        one-shot reset tokens used by our /reset-password route
//     - LoginAttempt         brute-force lockout journal hit from authorize()
//
// CMS resource tables (events, gallery, contact_forms, …) are intentionally NOT
// modelled here — NextOS reaches them via `prisma.$queryRawUnsafe()` with an
// identifier-safety guard so downstream apps can declare their own CMS
// resources without forking the package or regenerating Prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Authentication identity + Auth.js base fields + NextOS profile fields.
/// `password_hash` is used by the Credentials provider's `authorize()`.
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // ---- Auth.js required fields ----
  email          String    @unique
  emailVerified  DateTime? @db.Timestamptz(6)
  image          String?

  // ---- NextOS auth fields ----
  password_hash  String
  role           String    @default("viewer")
  is_active      Boolean   @default(true)
  // legacy boolean (kept for backwards-compat; superseded by emailVerified)
  email_verified Boolean   @default(false)

  // ---- NextOS profile fields ----
  name           String?
  first_name     String?
  last_name      String?
  phone          String?
  title          String?

  // ---- Timestamps ----
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  last_login_at  DateTime? @db.Timestamptz(6)

  metadata       Json      @default("{}")

  // ---- Relations ----
  accounts       Account[]
  sessions       Session[]
  password_resets PasswordReset[]

  @@map("users")
}

/// Auth.js Account model — links a provider account (Google, GitHub, etc.)
/// to a User. Populated by the Prisma adapter when OAuth providers sign in.
/// Empty while we only use Credentials.
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js Session model — used when the consuming app switches to
/// database sessions (OAuth providers). Credentials + JWT mode leaves this
/// table empty, but the adapter still expects the model to exist.
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Auth.js VerificationToken — magic-link / email-verification tokens.
/// Empty in Credentials-only setup.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// One-shot password-reset token (consumed on first use). NOT an Auth.js
/// table — used by our custom /forgot-password and /reset-password routes
/// since Auth.js's built-in email flow is magic-link-only.
model PasswordReset {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  used_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_password_resets_user")
  @@map("password_resets")
}

/// Brute-force lockout journal: one row per login attempt. Read by the
/// Credentials `authorize()` to enforce 5-failures / 15-min lockout.
model LoginAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier    String
  succeeded     Boolean
  ip_address    String?
  attempted_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier, attempted_at(sort: Desc)], map: "idx_login_attempts_identifier")
  @@map("login_attempts")
}
