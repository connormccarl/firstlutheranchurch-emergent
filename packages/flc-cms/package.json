{
  "name": "@flc/cms",
  "version": "0.1.0",
  "description": "Lightweight, opinionated CMS toolkit for Next.js + MongoDB applications. Built for First Lutheran Church of Miami; reusable anywhere.",
  "license": "MIT",
  "author": "First Lutheran Church of Miami",
  "keywords": [
    "cms",
    "next.js",
    "mongodb",
    "admin",
    "dashboard"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "mongodb": ">=6",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.507.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "mongodb": "^6.10.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.22.2",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
